# ==============================================================================
# HIMS KB Backend Fake Testing Environment Configuration (.env.test)
# ==============================================================================

# Django Core & Security
SECRET_KEY=django-insecure-ci-fake-secret-key-testing-only
DEBUG=False
ALLOWED_HOSTS=*
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# PostgreSQL Database Configuration (pgvector)
POSTGRES_DB=hims_kb_test_db
POSTGRES_USER=hims_kb_test_user
POSTGRES_PASSWORD=hims_kb_test_password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Redis Cache
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# AI Models & OpenRouter API Keys
OPENAI_API_KEY=sk-proj-fake-ci-openai-api-key-for-testing
OPENROUTER_API_KEY=sk-or-v1-fake-ci-openrouter-api-key-for-testing
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-5-mini
OPENROUTER_FALLBACK_MODELS=meta-llama/llama-3.1-8b-instruct,openai/gpt-5-mini
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small

# Email & Staff Credentials Notification Dispatch
RESEND_API_KEY=re_fake_ci_resend_api_key_for_testing
EMAIL_BACKEND=django.core.mail.backends.locmem.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=test-ci@example.com
EMAIL_HOST_PASSWORD=fake-ci-email-password
DEFAULT_FROM_EMAIL=no-reply@hims.org

