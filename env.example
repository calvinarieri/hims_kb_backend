# ==============================================================================
# HIMS KB Backend Environment Variables Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Django Core & Security Settings
# ------------------------------------------------------------------------------
SECRET_KEY=django-insecure-change-this-in-production-random-secret-key-12345
DEBUG=False
ALLOWED_HOSTS=*
CORS_ALLOWED_ORIGINS=https://your-frontend-domain.com,http://localhost:3000
CSRF_TRUSTED_ORIGINS=https://your-frontend-domain.com,http://localhost:3000
FRONTEND_URL=https://your-frontend-domain.com

# ------------------------------------------------------------------------------
# 2. PostgreSQL Database Configuration (pgvector)
# ------------------------------------------------------------------------------
POSTGRES_DB=hims_kb_db
POSTGRES_USER=hims_kb_user
POSTGRES_PASSWORD=your_secure_postgres_password_here
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# ------------------------------------------------------------------------------
# 3. Redis Caching & Queue Configuration
# ------------------------------------------------------------------------------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# ------------------------------------------------------------------------------
# 4. OpenRouter / OpenAI AI Models & Embedding Retrieval
# ------------------------------------------------------------------------------
OPENAI_API_KEY=sk-proj-your-openai-api-key-here
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-api-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-5-mini
OPENROUTER_FALLBACK_MODELS=meta-llama/llama-3.1-8b-instruct,openai/gpt-5-mini
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small

# ------------------------------------------------------------------------------
# 5. Email & Staff Credentials Notification Dispatch
# ------------------------------------------------------------------------------
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@domain.com
EMAIL_HOST_PASSWORD=your-email-app-password
DEFAULT_FROM_EMAIL=HIMS KB Notifications <no-reply@hims.org>

